<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Inline top bar: back chevron / screen title / Save action - a plain row rather than a
         MaterialToolbar so the "Save" text action can sit in accent green. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:padding="9dp"
            android:src="@drawable/ic_back_24"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/textFormTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.PB.CardTitle"
            tools:text="Edit Ingredient" />

        <TextView
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:padding="10dp"
            android:text="@string/action_save"
            android:textColor="@color/accent"
            android:textSize="16sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <!-- Large avatar preview + change-icon link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/avatarPreviewContainer"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_avatar"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/textAvatarPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textSize="42sp"
                        tools:text="🥫" />
                </FrameLayout>

                <TextView
                    android:id="@+id/buttonChangeIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="sans-serif-medium"
                    android:padding="6dp"
                    android:text="@string/action_change_icon"
                    android:textColor="@color/accent"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <!-- Grouped form section: Name / Quantity / Unit / Food Icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_group"
                android:orientation="vertical">

                <!-- Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_name"
                        android:textAppearance="@style/TextAppearance.PB.FieldLabel" />

                    <EditText
                        android:id="@+id/editName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:background="@null"
                        android:hint="@string/hint_name"
                        android:inputType="textCapSentences"
                        android:minHeight="26dp"
                        android:padding="0dp"
                        android:textAppearance="@style/TextAppearance.PB.FieldValue"
                        android:textColorHint="@color/text_tertiary" />

                    <TextView
                        android:id="@+id/textErrorName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/error"
                        android:textSize="12.5sp"
                        android:visibility="gone" />
                </LinearLayout>

                <View style="@style/PB.Divider" />

                <!-- Quantity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_quantity"
                        android:textAppearance="@style/TextAppearance.PB.FieldLabel" />

                    <EditText
                        android:id="@+id/editQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:background="@null"
                        android:hint="@string/hint_quantity"
                        android:inputType="numberDecimal"
                        android:minHeight="26dp"
                        android:padding="0dp"
                        android:textAppearance="@style/TextAppearance.PB.FieldValue"
                        android:textColorHint="@color/text_tertiary" />

                    <TextView
                        android:id="@+id/textErrorQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/error"
                        android:textSize="12.5sp"
                        android:visibility="gone" />
                </LinearLayout>

                <View style="@style/PB.Divider" />

                <!-- Unit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_unit"
                        android:textAppearance="@style/TextAppearance.PB.FieldLabel" />

                    <EditText
                        android:id="@+id/editUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:background="@null"
                        android:hint="@string/hint_unit"
                        android:inputType="text"
                        android:minHeight="26dp"
                        android:padding="0dp"
                        android:textAppearance="@style/TextAppearance.PB.FieldValue"
                        android:textColorHint="@color/text_tertiary" />
                </LinearLayout>

                <View style="@style/PB.Divider" />

                <!-- Food Icon -->
                <LinearLayout
                    android:id="@+id/rowFoodIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_food_icon"
                        android:textAppearance="@style/TextAppearance.PB.FieldLabel" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textFoodIconEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            tools:text="🍅" />

                        <TextView
                            android:id="@+id/textFoodIconLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.PB.FieldValue"
                            tools:text="Vegetables" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/PB.Divider" />

                <!-- Expiry date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_expiry_date"
                        android:textAppearance="@style/TextAppearance.PB.FieldLabel" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/editExpiryDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="26dp"
                            android:text="@string/hint_pick_date"
                            android:textAppearance="@style/TextAppearance.PB.FieldValue"
                            android:textColor="@color/text_tertiary" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar_24"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:id="@+id/textClearDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:fontFamily="sans-serif-medium"
                            android:padding="4dp"
                            android:text="@string/action_clear_date"
                            android:textColor="@color/accent"
                            android:textSize="13.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                style="@style/Widget.PB.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/action_delete"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
