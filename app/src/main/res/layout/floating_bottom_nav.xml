<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom floating "Liquid Glass"-style navigation bar, included (not a standard
    BottomNavigationView) so it can float above content with margins on all top-level
    screens: a semi-transparent tinted surface + thin border + soft elevation-based shadow,
    theme-aware via glass_nav_bg/glass_nav_border (see colors.xml / values-night). Wired up
    by BaseActivity.setupFloatingNav(). Migrated from SmartPantryManager.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingNav"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_gravity="bottom"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="20dp"
    app:cardBackgroundColor="@color/glass_nav_bg"
    app:cardCornerRadius="34dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/glass_nav_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navItemPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navIconPantry"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/nav_pantry"
                android:src="@drawable/ic_tab_pantry_24" />

            <TextView
                android:id="@+id/navLabelPantry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_pantry"
                android:textSize="11sp" />

            <View
                android:id="@+id/navDotPantry"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/ic_dot_24"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navItemRecipes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navIconRecipes"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/nav_suggested"
                android:src="@drawable/ic_tab_recipes_24" />

            <TextView
                android:id="@+id/navLabelRecipes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_suggested"
                android:textSize="11sp" />

            <View
                android:id="@+id/navDotRecipes"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/ic_dot_24"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navItemSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navIconSettings"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_tab_settings_24" />

            <TextView
                android:id="@+id/navLabelSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_settings"
                android:textSize="11sp" />

            <View
                android:id="@+id/navDotSettings"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/ic_dot_24"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
