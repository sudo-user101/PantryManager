<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                android:text="@string/title_settings"
                android:textAppearance="@style/TextAppearance.PB.LargeTitle" />

            <!-- ============================== APPEARANCE ============================== -->
            <TextView
                style="@style/PB.SettingsSectionHeader"
                android:text="@string/settings_section_appearance" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_section_group"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/PB.SettingsRow"
                    android:paddingVertical="14dp">

                    <FrameLayout style="@style/PB.SettingsIconChip">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_moon_24"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <TextView
                        style="@style/PB.SettingsRowTitle"
                        android:text="@string/settings_dark_mode_title" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/pb_switch_track" />
                </LinearLayout>

            </LinearLayout>

            <!-- ============================== PREFERENCES ============================== -->
            <TextView
                style="@style/PB.SettingsSectionHeader"
                android:text="@string/settings_section_preferences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_section_group"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/PB.SettingsRow"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <FrameLayout style="@style/PB.SettingsIconChip">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bell_24"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_expiry_alerts_title"
                            android:textAppearance="@style/TextAppearance.PB.CardTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/pref_expiry_alerts_summary"
                            android:textAppearance="@style/TextAppearance.PB.Secondary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchExpiryAlerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/pb_switch_track" />
                </LinearLayout>

            </LinearLayout>

            <!-- ============================== HELP ============================== -->
            <TextView
                style="@style/PB.SettingsSectionHeader"
                android:text="@string/settings_section_help" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_section_group"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/PB.SettingsRow"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <FrameLayout style="@style/PB.SettingsIconChip">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:text="?"
                            android:textColor="@color/accent"
                            android:textSize="15sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorial_mode_title"
                            android:textAppearance="@style/TextAppearance.PB.CardTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tutorial_mode_summary"
                            android:textAppearance="@style/TextAppearance.PB.Secondary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchTutorialMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/pb_switch_track" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_section_group"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowResetRecipes"
                    style="@style/PB.SettingsRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="14dp">

                    <FrameLayout style="@style/PB.SettingsIconChip">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tab_recipes_24"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_reset_recipes"
                            android:textAppearance="@style/TextAppearance.PB.CardTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/reset_recipes_summary"
                            android:textAppearance="@style/TextAppearance.PB.Secondary" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View style="@style/PB.Divider" />

                <LinearLayout
                    style="@style/PB.SettingsRow"
                    android:paddingVertical="14dp">

                    <FrameLayout style="@style/PB.SettingsIconChip">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tab_settings_24"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <TextView
                        style="@style/PB.SettingsRowTitle"
                        android:text="@string/app_name" />

                    <TextView
                        android:id="@+id/textAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PB.Secondary"
                        tools:text="Version 1.0" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/floating_bottom_nav" />

</FrameLayout>
