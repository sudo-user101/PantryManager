<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark palette - deliberately composed (distinct surface tiers, softened text/accent tones
    for OLED-black comfort), not a simple inversion of values/colors.xml. Migrated from
    SmartPantryManager.
-->
<resources>

    <!-- Surfaces -->
    <color name="background">#000000</color>
    <color name="surface">#1C1C1E</color>
    <color name="surface_secondary">#2C2C2E</color>

    <!-- Text -->
    <color name="text_primary">#F5F5F7</color>
    <color name="text_secondary">#98989D</color>
    <color name="text_tertiary">#6E6E73</color>

    <!-- Structure -->
    <color name="divider">#38383A</color>

    <!-- Accent - slightly lifted for legibility against near-black surfaces -->
    <color name="accent">#3E9C71</color>
    <color name="accent_pressed">#347F5D</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- Status -->
    <color name="warning">#E0954A</color>
    <color name="warning_bg">#332A1B</color>
    <color name="error">#E06060</color>
    <color name="error_bg">#332020</color>
    <color name="success">#3E9C71</color>
    <color name="success_bg">#1C2E24</color>

    <!-- Pantry item avatar background tints - muted dark tones, not bright pastels -->
    <color name="avatar_tint_red">#3A2626</color>
    <color name="avatar_tint_orange">#3A2E1F</color>
    <color name="avatar_tint_green">#223326</color>
    <color name="avatar_tint_blue">#212A33</color>
    <color name="avatar_tint_beige">#332E24</color>
    <color name="avatar_tint_pink">#332328</color>
    <color name="avatar_tint_neutral">#2C2C2E</color>

    <!-- Floating "Liquid Glass" navigation -->
    <color name="glass_nav_bg">#D91C1C1E</color>
    <color name="glass_nav_border">#40FFFFFF</color>
    <color name="nav_selected_capsule">#263E9C71</color>

</resources>
